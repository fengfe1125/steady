# Copy to .env.local, chmod 600 .env.local. Never commit private values.
DEEPSEEK_API_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_ID=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_POOLER_HOST=
SUPABASE_POOLER_PORT=5432
SUPABASE_POOLER_USER=
SUPABASE_REGION=ap-southeast-1
DEEPSEEK_MODEL=deepseek-flash
APPLE_TEAM_ID=
APPLE_CLIENT_ID=com.jiwo.steady
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
DELETION_ENCRYPTION_KEY=

# Custom SMTP is required for numeric OTP on a new free project
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Steady

# Keep a separate secure copy of this generated recovery secret.
STEADY_BACKUP_PASSPHRASE=
# Default: ~/Documents/SteadyBackups
STEADY_BACKUP_DIR=
