  "cue": "仰卧凳上，双脚踩实，肩胛后收下沉贴住凳面；肘微屈，沿弧线把哑铃下放到胸部两侧，再用胸带动将其夹回上方，顶点轻轻挤胸。",
  "mistake": {
    "title": "推起时耸肩前引，上背离凳",
    "fix": "合拢哑铃前先把肩胛向后向下收住并压紧凳面，用胸部带动手臂，顶到最高点时也不要让肩膀向耳朵方向跑。",
    "basis": "依据资料给出的常见错误（发力阶段肩部向前移、上背无法全程贴住凳面），并结合训练常识。",
    "level": 1,
    "override": {
      "scapE": {
        "r": 22,
        "l": 22
      }
    }
  },
  "observation": "主视频 512×512、13.94 秒。1.74 秒（frame02）双臂伸直合拢于胸口上方，4.07 秒（frame04）张到最低、哑铃降到胸部两侧，6.39 秒（frame06）再次回到顶端，一次往返约 4.65 秒、全场约 3 次；9.87 秒起机位切到脚端，因此取第 1 个完整往返 1.75–6.40 秒。人物仰卧在可调平凳上，头朝画面左侧并略超出凳端，双脚踩地、屈膝分开，双手各握一只哑铃、掌心相对；上背贴凳，髋部与双脚在整个动作里不移动。躯干角度、肘部弯曲量与哑铃下放高度按帧图人工拟合。 （2026-10-15 按用户决定改为从上方俯视的正面示范，以便看清双臂向两侧打开。）",
  "rotate": 90
}
